{
  "name": "ait-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:cn": "ASTRO_TELEMETRY_DISABLED=1 SITE_URL=https://aitapp.cn BUILD_TARGET=cn astro build",
    "build:com": "ASTRO_TELEMETRY_DISABLED=1 SITE_URL=https://ait-app.com BUILD_TARGET=com astro build",
    "build:all": "npm run build:cn && npm run build:com",
    "verify": "node scripts/verify-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1"
  },
  "dependencies": { "astro": "7.3.5" },
  "devDependencies": { "@astrojs/check": "0.9.10", "typescript": "6.0.3" }
}
