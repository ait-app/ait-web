---
import LanguageRedirect from '../components/LanguageRedirect.astro';
import { pathFor } from '../lib/site';
const destination = pathFor('en');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><LanguageRedirect /><meta name="robots" content="noindex, follow"/><title>Ait</title><link rel="icon" href="/brand/ait-mark-small.svg"/></head><body><a href={destination}>Visit Ait</a></body></html>
