---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { languages, pathFor, product, type Language } from '../../lib/site';
import { t } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const copy = t(lang).download;
---
<Base lang={lang} title={t(lang).nav.download} description={copy.description} path="download">
  <main id="main-content" class="download-page container">
    <div class="page-intro"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.description}</p></div>
    <h2 class="download-group-title">{copy.desktop}</h2>
    <div class="download-grid">
      <article class="download-card">
        <span class="download-icon"><Icon name="apple" size={32}/></span>
        <h2>{copy.mac}</h2><p>{copy.macDetail}</p>
        <a class="button button-primary" href={product.macDmgMirror.url} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{copy.latest}</a>
        <div class="download-mirror">
          <a class="text-link" href={product.macDmgMirror.url} target="_blank" rel="noopener noreferrer">{copy.chinaDownload}<Icon name="download" size={16}/></a>
          <small>Apple Silicon · DMG · v{product.macDmgMirror.version}</small>
        </div>
      </article>
      <article class="download-card">
        <span class="download-icon"><Icon name="terminal" size={32}/></span>
        <h2>{copy.linux}</h2><p>{copy.linuxDetail}</p>
        <a class="button button-dark" href={product.latestRelease} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{copy.latest}</a>
      </article>
    </div>
    <p class="release-note">{copy.releaseNote}</p>
    <p class="release-note"><a class="text-link" href={pathFor(lang,'docs/daemon')}>{copy.daemon}<Icon name="arrow" size={16}/></a></p>
    <h2 class="download-group-title">{copy.mobile}</h2>
    <div class="platform-grid">
      <article id="android">
        <Icon name="phone" size={26}/><h3>{copy.android}</h3><p>{copy.androidDetail}</p>
        <div class="platform-actions">
          <a class="button button-primary button-small" href={product.googlePlayTesting} target="_blank" rel="noopener noreferrer">{copy.androidTesting}<Icon name="external" size={16}/></a>
          <a class="text-link" href={pathFor(lang,'docs/platforms')}>{copy.androidGuide}<Icon name="arrow" size={16}/></a>
        </div>
      </article>
      <article id="ios">
        <Icon name="phone" size={26}/><h3>{copy.ios}</h3><p>{copy.iosDetail}</p>
        <div class="platform-actions">
          <a class="button button-small button-dark" href={product.testFlightPublicUrl} target="_blank" rel="noopener noreferrer">{copy.testFlight}<Icon name="external" size={15}/></a>
          <a class="text-link" href={`${pathFor(lang,'docs/platforms')}${lang === 'zh' ? '#iphone-和-ipad' : ''}`}>{copy.guide}<Icon name="arrow" size={16}/></a>
        </div>
        {lang !== 'zh' && <small class="platform-note">{copy.testFlightNote}</small>}
      </article>
      <article id="web"><Icon name="globe" size={26}/><h3>{copy.web}</h3><p>{copy.webDetail}</p><a class="text-link" href={product.webApp} target="_blank" rel="noopener noreferrer">{copy.openWeb}<Icon name="external" size={16}/></a></article>
    </div>
    <div class="download-prerequisite"><Icon name="layers" size={28}/><div><h3>{copy.prerequisite}</h3><p>{copy.prerequisiteDetail}</p></div><a class="text-link" href={pathFor(lang,'docs/providers')}>{copy.prerequisiteLink}<Icon name="arrow" size={16}/></a></div>
  </main>
</Base>
