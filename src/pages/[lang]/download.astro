---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { languages, pathFor, product, type Language } from '../../lib/site';
import { t } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const copy = t(lang).download;
---
<Base lang={lang} title={t(lang).nav.download} description={copy.description} path="download">
  <main id="main-content" class="download-page container">
    <div class="page-intro"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.description}</p></div>
    <h2 class="download-group-title">{copy.desktop}</h2>
    <div class="download-grid">
      <article class="download-card">
        <span class="download-icon"><Icon name="apple" size={32}/></span>
        <h2>{copy.mac}</h2><p>{copy.macDetail}</p>
        <a class="button button-primary" href={product.latestRelease} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{copy.latest}</a>
        <div class="download-mirror">
          <a class="text-link" href={product.macDmgMirror.url} target="_blank" rel="noopener noreferrer">{copy.chinaDownload}<Icon name="download" size={16}/></a>
          <small>Apple Silicon · DMG · v{product.macDmgMirror.version}</small>
        </div>
      </article>
      <article class="download-card">
        <span class="download-icon"><Icon name="terminal" size={32}/></span>
        <h2>{copy.linux}</h2><p>{copy.linuxDetail}</p>
        <a class="button button-dark" href={product.latestRelease} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{copy.latest}</a>
      </article>
    </div>
    <p class="release-note">{copy.releaseNote}</p>
    <h2 class="download-group-title">{copy.mobile}</h2>
    <div class="platform-grid">{[
      {id:'android',title:copy.android,description:copy.androidDetail,icon:'phone'},
      {id:'ios',title:copy.ios,description:copy.iosDetail,icon:'phone'},
      {id:'web',title:copy.web,description:copy.webDetail,icon:'globe'},
    ].map(platform => <article id={platform.id}>
      <Icon name={platform.icon} size={26}/><h3>{platform.title}</h3><p>{platform.description}</p>
      <div class="platform-actions">
        {platform.id === 'ios' && <a class="button button-small button-dark" href={product.testFlightPublicUrl} target="_blank" rel="noopener noreferrer">{copy.testFlight}<Icon name="external" size={15}/></a>}
        <a class="text-link" href={pathFor(lang,'docs/platforms')}>{copy.guide}<Icon name="arrow" size={16}/></a>
      </div>
      {platform.id === 'ios' && <small class="platform-note">{copy.testFlightNote}</small>}
    </article>)}</div>
    <div class="download-prerequisite"><Icon name="layers" size={28}/><div><h3>{copy.prerequisite}</h3><p>{copy.prerequisiteDetail}</p></div><a class="text-link" href={pathFor(lang,'docs/providers')}>{copy.prerequisiteLink}<Icon name="arrow" size={16}/></a></div>
  </main>
</Base>
