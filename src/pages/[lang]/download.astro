---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { languages, pathFor, product, type Language } from '../../lib/site';
import { t } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const { download: copy, docs, nav } = t(lang);
---
<Base lang={lang} title={nav.download} description={copy.description} path="download">
  <main id="main-content" class="download-page container">
    <div class="page-intro"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.description}</p></div>
    <section aria-labelledby="desktop-apps">
      <h2 id="desktop-apps" class="download-group-title">{copy.desktop}</h2>
      <div class="download-grid">
        <article class="download-card">
          <div class="download-card-heading"><span class="download-icon"><Icon name="apple" size={25}/></span><h3>{copy.mac}</h3></div>
          <p>{copy.macDetail}</p>
          <a class="button button-primary" href={product.macDmgMirror.url} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{copy.latest}</a>
          <div class="download-mirror">
            <a class="text-link" href={product.macDmgMirror.url} target="_blank" rel="noopener noreferrer">{copy.chinaDownload}<Icon name="download" size={16}/></a>
            <small>DMG · v{product.macDmgMirror.version}</small>
          </div>
        </article>
        <article class="download-card download-card-linux">
          <div class="download-card-heading"><span class="download-icon"><Icon name="terminal" size={25}/></span><h3>{copy.linux}</h3></div>
          <div class="download-install">
            <h4>Arch Linux (AUR)</h4>
            <div class="download-command" data-copy-label={docs.copy} data-copied-label={docs.copied} data-copy-error={docs.copyError}>
              <code>paru -S ait-bin</code>
              <button type="button" class="code-copy" hidden>{docs.copy}</button>
            </div>
            <p>{copy.archDetail}</p>
          </div>
          <div class="download-install">
            <h4>{copy.otherLinux}</h4>
            <p>{copy.linuxPackages}</p>
            <div class="download-install-actions">
              <a class="button button-dark" href={product.latestRelease} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{copy.latest}</a>
              <a class="text-link" href={`${pathFor(lang, 'docs/platforms')}#linux-x86_64`}>{copy.linuxGuide}<Icon name="arrow" size={16}/></a>
            </div>
          </div>
        </article>
        <article class="download-card">
          <div class="download-card-heading"><span class="download-icon"><Icon name="laptop" size={25}/></span><h3>{copy.windows}</h3></div>
          <p>{copy.windowsDetail}</p>
          <a class="button button-dark" href={product.latestRelease} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{copy.latest}</a>
        </article>
      </div>
      <div class="download-prerequisite download-daemon">
        <Icon name="terminal" size={25}/>
        <div><h3>{copy.daemon}</h3><p>{copy.daemonDetail}</p></div>
        <a class="text-link" href={pathFor(lang, 'docs/daemon')}>{copy.daemonGuide}<Icon name="arrow" size={16}/></a>
      </div>
      <p class="release-note">{copy.releaseNote}</p>
    </section>

    <section class="download-start" aria-labelledby="how-to-start">
      <h2 id="how-to-start" class="download-group-title">{copy.start}</h2>
      <div class="feature-grid download-start-grid">
        <article class="download-start-path">
          <h3><span aria-hidden="true">01</span>{copy.online}</h3>
          <p class="download-start-note">{copy.onlineNote}</p>
          <ul>
            <li>
              <strong>{copy.desktopUser}</strong>
              <p>{copy.onlineDesktop}</p>
            </li>
            <li>
              <strong>{copy.headlessUser}</strong>
              <p>{copy.onlineHeadlessBrowser}</p>
              <div class="download-command" data-copy-label={docs.copy} data-copied-label={docs.copied} data-copy-error={docs.copyError}>
                <code>aitd login</code>
                <button type="button" class="code-copy" hidden>{docs.copy}</button>
              </div>
              <p>{copy.onlineHeadlessToken}</p>
              <div class="download-command" data-copy-label={docs.copy} data-copied-label={docs.copied} data-copy-error={docs.copyError}>
                <code>aitd login --token-stdin</code>
                <button type="button" class="code-copy" hidden>{docs.copy}</button>
              </div>
              <p>{copy.onlineHeadlessRun}</p>
              <div class="download-command" data-copy-label={docs.copy} data-copied-label={docs.copied} data-copy-error={docs.copyError}>
                <code>aitd run</code>
                <button type="button" class="code-copy" hidden>{docs.copy}</button>
              </div>
            </li>
          </ul>
          <div class="download-start-links">
            <a class="text-link" href={pathFor(lang, 'docs/quick-start')}>{copy.quickStart}<Icon name="arrow" size={16}/></a>
            <a class="text-link" href={`${pathFor(lang, 'docs/daemon')}#${copy.keepRunningAnchor}`}>{copy.keepRunning}<Icon name="arrow" size={16}/></a>
          </div>
        </article>
        <article class="download-start-path">
          <h3><span aria-hidden="true">02</span>{copy.lan}</h3>
          <p class="download-start-note">{copy.lanNote}</p>
          <ul>
            <li>
              <strong>{copy.desktopUser}</strong>
              <p>{copy.lanDesktop}</p>
            </li>
            <li>
              <strong>{copy.headlessUser}</strong>
              <p>{copy.lanHeadlessIntro[0]}<code>127.0.0.1:7316</code>{copy.lanHeadlessIntro[1]}</p>
              <div class="download-command" data-copy-label={docs.copy} data-copied-label={docs.copied} data-copy-error={docs.copyError}>
                <code>aitd run --listen 192.168.1.10:7316</code>
                <button type="button" class="code-copy" hidden>{docs.copy}</button>
              </div>
              <p>{copy.lanHeadlessToken}</p>
            </li>
            <li>
              <strong>{copy.lanClient}</strong>
              <p>{copy.lanConnect}</p>
            </li>
          </ul>
          <div class="download-start-links">
            <a class="text-link" href={pathFor(lang, 'docs/connection')}>{copy.connectionGuide}<Icon name="arrow" size={16}/></a>
            <a class="text-link" href={`${pathFor(lang, 'docs/configuration')}#${copy.configurationAnchor}`}>{copy.configurationGuide}<Icon name="arrow" size={16}/></a>
          </div>
        </article>
      </div>
    </section>

    <h2 class="download-group-title">{copy.mobile}</h2>
    <div class="platform-grid">
      <article id="android">
        <Icon name="phone" size={26}/><h3>{copy.android}</h3><p>{copy.androidDetail}</p>
        <div class="platform-actions">
          <a class="button button-primary button-small" href={product.googlePlayTesting} target="_blank" rel="noopener noreferrer">{copy.androidTesting}<Icon name="external" size={16}/></a>
          <a class="text-link" href={pathFor(lang,'docs/platforms')}>{copy.androidGuide}<Icon name="arrow" size={16}/></a>
        </div>
      </article>
      <article id="ios">
        <Icon name="phone" size={26}/><h3>{copy.ios}</h3><p>{copy.iosDetail}</p>
        <div class="platform-actions">
          <a class="button button-small button-dark" href={product.testFlightPublicUrl} target="_blank" rel="noopener noreferrer">{copy.testFlight}<Icon name="external" size={15}/></a>
          <a class="text-link" href={`${pathFor(lang,'docs/platforms')}#${copy.iosAnchor}`}>{copy.guide}<Icon name="arrow" size={16}/></a>
        </div>
      </article>
      <article id="web"><Icon name="globe" size={26}/><h3>{copy.web}</h3><p>{copy.webDetail}</p><a class="text-link" href={product.webApp} target="_blank" rel="noopener noreferrer">{copy.openWeb}<Icon name="external" size={16}/></a></article>
    </div>
    <div class="download-prerequisite"><Icon name="layers" size={28}/><div><h3>{copy.prerequisite}</h3><p>{copy.prerequisiteDetail}</p></div><a class="text-link" href={pathFor(lang,'docs/providers')}>{copy.prerequisiteLink}<Icon name="arrow" size={16}/></a></div>
  </main>
</Base>
<script>
  import { bindCodeCopy } from '../../lib/code-copy';

  document.querySelectorAll<HTMLElement>('.download-command').forEach(row => {
    const code = row.querySelector('code');
    const button = row.querySelector('button');
    if (!code || !button) return;
    bindCodeCopy(button, code, row);
    button.hidden = false;
  });
</script>
