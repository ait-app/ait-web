---
import { canonicalFor, pathFor } from '../lib/site';
import { t } from '../lib/i18n';
const lang = __DEFAULT_LOCALE__;
const destination = pathFor(lang, 'privacy');
const title = t(lang).footer.privacy;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script define:vars={{ destination }}>
      window.location.replace(destination + window.location.search + window.location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalFor(lang, 'privacy')} />
    <link rel="icon" href="/brand/ait-mark-small.svg" />
    <title>{title} · Ait</title>
  </head>
  <body><a href={destination}>{title}</a></body>
</html>
