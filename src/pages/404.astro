---
import Base from '../layouts/Base.astro';
import { pathFor } from '../lib/site';
import { t } from '../lib/i18n';
const lang = __DEFAULT_LOCALE__;
const copy = t(lang).notFound;
---
<Base lang={lang} title="404" noindex><main class="not-found container" id="main-content"><img src="/brand/ait-mark.svg" alt="" width="96" height="68"/><p class="eyebrow">404 / OFF THE MAP</p><h1>{copy.title}</h1><p>{copy.description}</p><a class="button button-dark" href={pathFor(lang)}>{copy.cta}</a></main></Base>
