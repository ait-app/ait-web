---
import { pathFor } from '../lib/site';
interface Props { path?: string; }
const { path = '' } = Astro.props;
const destinations = { zh: pathFor('zh', path), en: pathFor('en', path) };
const defaultLanguage = __DEFAULT_LOCALE__;
---
<script define:vars={{ destinations, defaultLanguage }}>
  const preferences = navigator.languages?.length ? navigator.languages : [navigator.language];
  const language = preferences
    .map(locale => locale.toLowerCase().split('-')[0])
    .find(locale => locale === 'zh' || locale === 'en') ?? defaultLanguage;
  window.location.replace(destinations[language] + window.location.search + window.location.hash);
</script>
<noscript><meta http-equiv="refresh" content={`0;url=${destinations.en}`} /></noscript>
