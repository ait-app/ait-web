---
import type { AgentProvider } from '../lib/site';
interface Props { provider: AgentProvider; size?: number; }
const { provider, size = 24 } = Astro.props;
const assets = {
  codex: 'codex.png',
  'deepseek-harness': 'deepseek-harness.svg',
  opencode: 'opencode.svg',
  antigravity: 'antigravity.svg',
  claude: 'claude.png',
} satisfies Record<AgentProvider, string>;
---
<img class="provider-icon" src={`/providers/${assets[provider]}`} width={size} height={size} alt="" aria-hidden="true" />
<style>
  .provider-icon { display: block; flex-shrink: 0; object-fit: contain; }
</style>
