---
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import { languages, locales, pathFor, product, type Language } from '../lib/site';
interface Props { lang: Language; path?: string; docs?: boolean; alternates?: readonly Language[]; }
const { lang, path = '', docs = false, alternates = languages } = Astro.props;
const copy = t(lang);
// A language without this page (e.g. an untranslated blog post) falls back to that language's blog index.
const switchPath = (target: Language) => alternates.includes(target) ? path : path.startsWith('blog/') ? 'blog' : '';
const links = [
  { label: copy.nav.product, path: '', active: !path },
  { label: copy.nav.blog, path: 'blog', active: path.startsWith('blog') },
  { label: copy.nav.docs, path: 'docs', active: path.startsWith('docs') },
];
---
<header class:list={['site-header', { 'docs-header': docs }]}>
  <div class="header-inner">
    <a class="brand" href={pathFor(lang)} aria-label="Ait"><img src="/brand/ait-lockup-horizontal.svg" width="114" height="43" alt="AIT" /></a>
    <nav class="desktop-nav" aria-label={copy.a11y.mainNav}>
      {links.map(link => <a href={pathFor(lang, link.path)} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
      <a href={product.webApp} target="_blank" rel="noopener noreferrer">{copy.nav.webApp}</a>
    </nav>
    <div class="header-actions">
      <details class="language-menu">
        <summary class="language-switch" aria-label={`${locales[lang].short} · ${copy.nav.language}`}><Icon name="globe" size={16} /><span>{locales[lang].short}</span></summary>
        <nav aria-label={copy.nav.language}>{languages.map(target => <a href={pathFor(target, switchPath(target))} hreflang={locales[target].hreflang} lang={locales[target].htmlLang} aria-current={target === lang ? 'true' : undefined}>{locales[target].name}</a>)}</nav>
      </details>
      <a class="github-link" href={product.repository} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" size={21} /></a>
      <a class="button button-small button-dark header-download" href={pathFor(lang, 'download')}>{copy.nav.download}<Icon name="download" size={15}/></a>
      <details class="mobile-nav">
        <summary aria-label={copy.nav.menu}><span></span><span></span></summary>
        <nav aria-label={copy.nav.menu}>{links.map(link => <a href={pathFor(lang, link.path)} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}<a href={product.webApp} target="_blank" rel="noopener noreferrer">{copy.nav.webApp}</a><a href={pathFor(lang, 'download')}>{copy.nav.download}</a></nav>
      </details>
    </div>
  </div>
</header>
