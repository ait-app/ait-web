---
import Icon from './Icon.astro';
import ProviderIcon from './ProviderIcon.astro';
import { t } from '../lib/i18n';
import type { Language } from '../lib/site';
interface Props { lang: Language; }
const { lang } = Astro.props;
const copy = t(lang).home;
const demo = t(lang).demo;
const tasks = demo.tasks;
---
<section class="demo-section container" aria-label={copy.demoHint}>
  <div class="demo-toolbar"><p>{copy.demoCaption}<span>{copy.demoLabel}</span></p><div class="demo-tabs" role="tablist" aria-label={copy.demoHint}>{copy.tabs.map((label, i) => <button type="button" role="tab" id={`demo-tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`demo-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-demo-tab={i}>{label}</button>)}</div></div>
  <div class="app-window">
    <div class="app-titlebar"><div class="traffic-lights"><i></i><i></i><i></i></div><span>Ait<span class="titlebar-separator">/</span>personal-website</span><span class="local-host"><Icon name="laptop" size={13}/>{demo.myComputer}</span></div>
    <div class="app-layout">
      <aside class="app-sidebar">
        <div class="app-sidebar-heading"><img src="/brand/ait-mark.svg" width="28" height="20" alt=""/><strong>{demo.workspaces}</strong><Icon name="plus" size={15}/></div>
        <div class="app-new"><Icon name="plus" size={15}/>{demo.newWorkspace}</div>
        <span class="sidebar-label">{demo.projects}</span>
        <div class="app-project"><Icon name="folder" size={15}/>personal-website<span>3</span></div>
        {tasks.map((task, i) => <div class:list={['app-task', { 'task-active': i === 0 }]}><i class={i === 1 ? 'task-dot dot-blue' : 'task-dot dot-green'}></i><span>{task}<small>{i === 0 ? 'Claude Code' : i === 1 ? 'Codex' : 'OpenCode'}</small></span><span class="task-time">{i === 0 ? 'now' : `${i * 4}m`}</span></div>)}
        <div class="app-project project-secondary"><Icon name="folder" size={15}/>side-project<span>2</span></div>
        <div class="sidebar-bottom"><span class="host-dot"></span>{demo.connectedLocally}<Icon name="shield" size={13}/></div>
      </aside>
      <div class="demo-panel" id="demo-panel-0" role="tabpanel" aria-labelledby="demo-tab-0" data-demo-panel="0">
        <div class="app-chat">
          <div class="app-pane-heading"><ProviderIcon provider="claude" size={18} /><strong>Claude Code</strong><span class="app-model">Sonnet</span><span class="pane-more">•••</span></div>
          <div class="chat-body"><div class="chat-user"><span class="avatar">Y</span><div><strong>{demo.you}</strong><p>{demo.prompt}</p></div></div>
          <div class="chat-assistant"><img src="/brand/ait-mark.svg" alt="" width="23" height="17"/><div><strong>Claude Code</strong><p>{demo.reply}</p><div class="tool-call"><Icon name="file" size={13}/><span>Read <code>src/pages/index.astro</code></span><Icon name="check" size={13}/></div><div class="tool-call"><Icon name="terminal" size={13}/><span>Run <code>npm run build</code></span><Icon name="check" size={13}/></div><p class="chat-result">{demo.result}</p><ul>{demo.bullets.map(bullet => <li>{bullet}</li>)}</ul><div class="chat-change"><Icon name="git" size={14}/><span>2 {demo.filesChanged}</span><span class="diff-plus">+128</span><span class="diff-minus">−12</span></div></div></div></div>
          <div class="app-composer"><span>{demo.composer}</span><div><span><Icon name="plus" size={14}/> Claude Code <span class="composer-mode">Default</span></span><span class="send-icon">↑</span></div></div>
        </div>
        <div class="app-code"><div class="app-pane-heading"><Icon name="file" size={14}/><strong>{demo.changes}</strong><span class="diff-plus">+128</span><span class="diff-minus">−12</span></div><div class="code-file"><Icon name="file" size={13}/> src/pages/index.astro <span>M</span></div><div class="diff-code"><div><span>01</span><code>---</code></div><div><span>02</span><code>import Layout from './Layout';</code></div><div><span>03</span><code>---</code></div><div><span>04</span><code></code></div><div class="code-added"><span>05</span><code>+ &lt;Layout title="Hello, world"&gt;</code></div><div class="code-added"><span>06</span><code>+   &lt;main class="home"&gt;</code></div><div class="code-added"><span>07</span><code>+     &lt;h1&gt;Make room</code></div><div class="code-added"><span>08</span><code>+       for ideas.&lt;/h1&gt;</code></div><div class="code-added"><span>09</span><code>+     &lt;p&gt;A little space</code></div><div class="code-added"><span>10</span><code>+       for what’s next.&lt;/p&gt;</code></div><div class="code-added"><span>11</span><code>+   &lt;/main&gt;</code></div><div class="code-added"><span>12</span><code>+ &lt;/Layout&gt;</code></div></div><div class="app-terminal"><div><Icon name="terminal" size={13}/>Terminal</div><p><span>›</span> npm run build<br/><span class="terminal-success">✓</span> Build completed.<br/><span class="terminal-muted">Ready when you are.</span><span class="terminal-cursor"></span></p></div></div>
      </div>
      <div class="demo-panel demo-review" id="demo-panel-1" role="tabpanel" aria-labelledby="demo-tab-1" data-demo-panel="1" hidden><div class="review-content"><div class="app-pane-heading"><Icon name="git" size={16}/><strong>{demo.reviewTitle}</strong><span class="app-model">main</span></div><div class="review-message"><span class="review-check"><Icon name="check" size={25}/></span><h3>{demo.reviewHeading}</h3><p>{demo.reviewBody}</p><div class="review-file"><Icon name="file"/>src/pages/index.astro<span class="diff-plus">+96</span><span class="diff-minus">−8</span></div><div class="review-file"><Icon name="file"/>src/styles/global.css<span class="diff-plus">+32</span><span class="diff-minus">−4</span></div><div class="review-status"><Icon name="check" size={15}/>npm run build<span>passed</span></div></div></div></div>
      <div class="demo-panel demo-connect" id="demo-panel-2" role="tabpanel" aria-labelledby="demo-tab-2" data-demo-panel="2" hidden><div class="connect-demo-content"><img src="/brand/ait-mark.svg" alt="" width="90" height="64"/><h3>{demo.connectHeading}</h3><p>{demo.connectBody}</p><div class="host-card"><Icon name="laptop" size={26}/><div><strong>My MacBook</strong><small>personal-website · 3 {demo.agents}</small></div><span class="host-state">{demo.online}</span></div><span class="connect-demo-note">{demo.connectNote}</span></div></div>
    </div>
    <div class="app-statusbar"><span><Icon name="git" size={12}/> main</span><span>personal-website<span class="statusbar-divider">/</span>{demo.allSaved}</span><span><Icon name="shield" size={12}/> {demo.runningLocally}</span></div>
  </div>
</section>
<script>
  const demoTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-demo-tab]')];
  const selectTab = (tab: HTMLButtonElement) => {
    demoTabs.forEach(button => { const selected = button === tab; button.setAttribute('aria-selected', String(selected)); button.tabIndex = selected ? 0 : -1; });
    document.querySelectorAll<HTMLElement>('[data-demo-panel]').forEach(panel => { panel.hidden = panel.dataset.demoPanel !== tab.dataset.demoTab; });
  };
  demoTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', event => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % demoTabs.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + demoTabs.length) % demoTabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = demoTabs.length - 1;
      else return;
      event.preventDefault(); selectTab(demoTabs[next]); demoTabs[next].focus();
    });
  });
</script>
