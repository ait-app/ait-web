---
import type { CollectionEntry } from 'astro:content';
import { docPath, pathFor, groups, type Language } from '../lib/site';
import { t } from '../lib/i18n';
import Icon from './Icon.astro';
interface Props { lang: Language; pages: CollectionEntry<'docs'>[]; slug: string; }
const { lang, pages, slug } = Astro.props;
---
<nav class="docs-nav" aria-label={t(lang).a11y.docsNav}>
  {Object.entries(groups[lang]).map(([group, label]) => (
    <div class:list={['docs-nav-group', { 'docs-nav-primary': group === 'quickstart' }]}>
      {group !== 'quickstart' && <h2>{label}</h2>}
      {pages.filter(page => page.data.group === group).map(page => (
        <a href={pathFor(lang, docPath(page.data.slug))} aria-current={page.data.slug === slug ? 'page' : undefined}>
          {group === 'quickstart' && <Icon name="arrow" size={16}/>}
          {page.data.title}
        </a>
      ))}
    </div>
  ))}
</nav>
