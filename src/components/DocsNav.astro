---
import type { CollectionEntry } from 'astro:content';
import { docPath, pathFor, groups, type Language } from '../lib/site';
interface Props { lang: Language; pages: CollectionEntry<'docs'>[]; slug: string; }
const { lang, pages, slug } = Astro.props;
---
<nav class="docs-nav" aria-label={lang === 'zh' ? '文档导航' : 'Documentation navigation'}>{Object.entries(groups[lang]).map(([group,label]) => <div class="docs-nav-group"><h2>{label}</h2>{pages.filter(page => page.data.group === group).map(page => <a href={pathFor(lang,docPath(page.data.slug))} aria-current={page.data.slug === slug ? 'page' : undefined}>{page.data.title}</a>)}</div>)}</nav>
