---
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import { pathFor, product, type Language } from '../lib/site';
interface Props { lang: Language; }
const { lang } = Astro.props;
const copy = t(lang).footer;
---
<footer class="site-footer">
  <div class="footer-main container">
    <div class="footer-brand"><a href={pathFor(lang)} aria-label="Ait"><img src="/brand/ait-lockup-horizontal.svg" width="114" height="43" alt="AIT" /></a><p>{copy.tagline}</p><a class="footer-contact" href={`mailto:${product.supportEmail}`}>{product.supportEmail}</a></div>
    <div class="footer-links"><span>{copy.product}</span><a href={pathFor(lang, 'download')}>{t(lang).nav.download}</a><a href={product.webApp} target="_blank" rel="noopener noreferrer">{t(lang).nav.webApp}<Icon name="external" size={12}/></a><a href={product.repository} target="_blank" rel="noopener noreferrer">{copy.source}<Icon name="external" size={12} /></a><a href={product.releases} target="_blank" rel="noopener noreferrer">{copy.releases}<Icon name="external" size={12}/></a></div>
    <div class="footer-links"><span>{copy.resources}</span><a href={pathFor(lang, 'docs')}>{copy.start}</a><a href={pathFor(lang, 'blog')}>{t(lang).nav.blog}</a><a href={pathFor(lang, 'docs/support')}>{copy.support}</a><a href={pathFor(lang, 'privacy')}>{copy.privacy}</a><a href={`/${lang}/rss.xml`}>{copy.rss}<Icon name="rss" size={13}/></a></div>
  </div>
  <div class="footer-bottom container"><span>© {new Date().getFullYear()} Ait. {copy.copyright}</span><span>{copy.status}</span><a href={pathFor(lang === 'zh' ? 'en' : 'zh')}>{lang === 'zh' ? 'English' : '简体中文'}<Icon name="globe" size={14}/></a></div>
</footer>
